@model IEnumerable<IdentityRole>
@{
    ViewBag.Title = "All Roles";
}
<h2 class="mb-4">@ViewBag.Title</h2>
@if (Model.Any())
{
    @if ((await authorizationService.AuthorizeAsync(User, "CreateRolePolicy")).Succeeded)
    {
        <a asp-action="CreateRole"
        class="btn btn-primary mb-3 w-auto">
            Add Role
        </a>
    }

    @foreach (var role in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">@role.Name</h5>
                    <small class="text-muted">Role ID: @role.Id</small>
                </div>

                <div>
                    <form method="post" 
                          asp-action="DeleteRole"
                          asp-route-id="@role.Id">

                          @if((await authorizationService.AuthorizeAsync(User, "EditRolePolicy")).Succeeded)
                          {
                            <a asp-action="EditRole"
                               asp-route-id="@role.Id"
                               class="btn btn-primary">
                                Edit
                            </a>
						  }

                        <span id="confirmDeleteSpan_@role.Id" 
                              style="display:none;">
                            <span class="fw-bold">Are you sure you want to delete?</span>
                              <button type="submit" class="btn btn-danger">Yes</button>
                              <a href="#" class="btn btn-secondary"
                                 onclick="confirmDelete('@role.Id',false)">No</a>
                        </span>
                        @if ((await authorizationService
                             .AuthorizeAsync(User, "DeleteRolePolicy")).Succeeded)
                        {
                            <span id="deleteSpan_@role.Id">
                                <a href="#" class="btn btn-danger"
							   onclick="confirmDelete('@role.Id',true)">Delete</a>
							</span>
						}
                      </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body">
            <h5>No roles have been created.</h5>
            <a asp-action="CreateRole" 
               class="btn btn-primary mt-2 w-auto">
                Create Role
            </a>
        </div>
    </div>
}

@section Scripts
{
    <script src="~/js/customscripts.js"></script>
}