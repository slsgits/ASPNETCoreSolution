@model EditRoleViewModel
@{
	ViewBag.Title = "Edit Role";
}
<h1>@ViewBag.Title</h1>
<div class="row">
	<div class="border rounded p-4 shadow-sm col-md-12">
		<form method="post" 
			 asp-controller="administration" 
			 asp-action="editRole">
			<div asp-validation-summary="All" class="text-danger"></div>
			<input asp-for="Id" type="hidden" />
			<div class="mb-3">
				<label asp-for="Id"></label>
				<input asp-for="Id" disabled class="form-control" />
			</div>
			<div class="mb-3">
				<label asp-for="RoleName"></label>
				<input asp-for="RoleName" class="form-control" />
				<span asp-validation-for="RoleName" class="text-danger"></span>
			</div>
			<button type="submit" class="btn btn-primary w-auto">Update</button>
			<a asp-action="ListRoles" class="btn btn-secondary w-auto">Cancel</a>
			<div class="mb-3">
				<h5 class="mt-4">Users in this role:</h5>
				@if (Model.Users.Any())
				{
					<ul class="list-group">
						@foreach (var user in Model.Users)
						{
							<li class="list-group-item">@user</li>
						}
					</ul>
				}
				else
				{
					<p class="text-muted">No users are assigned to this role.</p>
				}
			</div>
			<div class=""> 
				<a asp-action="EditUsersInRole"
				   asp-controller="Administration"
				   asp-route-roleId = "@Model.Id"
				   class="btn btn-primary w-auto">
				Add Or Remove Users</a>
			</div>
		</form>
	</div>
</div>