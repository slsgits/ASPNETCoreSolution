@model CreateRoleViewModel
@{
	ViewBag.Title = "Create New Role";
}
<h1>@ViewBag.Title</h1>
<div class="row">
	<div class="border rounded p-4 shadow-sm col-md-12">
		<form method="post" 
	     asp-controller="administration" 
		 asp-action="createRole">
			<div asp-validation-summary="All" class="text-danger"></div>
			<div class="row mb-3">
				<label asp-for="RoleName" class="col-sm-2 col-form-label"></label>
				<div class="col-sm-10">
				<input asp-for="RoleName" class="form-control" placeholder="Role Name" />
				<span asp-validation-for="RoleName" class="text-danger"></span>
				</div>
			</div>
			<button type="submit" class="btn btn-primary w-auto">Create Role</button>
			<a asp-action="ListRoles"
               asp-controller="Administration"
			   class="btn btn-secondary">Cancel</a>
		</form>
	</div>
</div>