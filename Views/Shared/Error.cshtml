@if (!string.IsNullOrEmpty(ViewBag.Title))
{
    <h1 class="text-danger">@ViewBag.Title</h1>
    <h6 class="alert-danger">@ViewBag.ErrorMessage</h6>
}
else
{
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">An Error Occurred</h4>
                </div>
                <div class="card-body">
                    <p class="lead text-muted">
                        The support team has been notified and will investigate the issue.
                    </p>
                    <p>
                        Please contact us at
                        <a href="mailto:shantilal.suthar@yahoo.com" class="text-decoration-none">
                            shantilal.suthar@yahoo.com
                        </a>
                    </p>
                </div> 
            </div>
        </div>
    </div>
</div>
}