<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="mb-0">Check Your Email</h3>
            </div>

            <div class="card-body text-center">

                <i class="bi bi-envelope-check display-4 text-success"></i>

                <p class="mt-3">
                    If an account with the provided email address exists,<br />
                    a password reset link has been sent.
                </p>

                <p class="text-muted">
                    Please check your inbox and follow <br /> 
                    the instructions to reset your password.
                </p>

                <a asp-action="Login"
                   class="btn btn-primary mt-2 w-auto">
                    Back to Login
                </a>

            </div>

        </div>

    </div>
</div>