@model HomeDetailsViewModel
@{
    ViewBag.Title = "Employee Details";
    //var photoPath = "~/images/" + (Model.Employee.PhotoPath ?? "me.jpg");
}
<div class="row justify-content-center m-3">
    <div class="col-sm-8">
        <div class="card">
            <div class="card-header">
                <h1>@Model.Employee.Name</h1>
            </div>

            <div class="card-body text-center">
                <div class="row">
                    @if (Model.Employee.Photos != null && Model.Employee.Photos.Any())
                    {
                        @foreach (var photo in Model.Employee.Photos)
                        {
                            var photoPath = string.IsNullOrEmpty(photo.FileName) ? "noimage.jpg" : photo.FileName;

                            <div class="col-md-3 mb-3 text-center">
                                <img src="~/images/@photoPath"
                                     class="img-thumbnail"
                                     style="height:150px; width:150px; object-fit:contain;"
                                     asp-append-version="true" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-3 mb-3 text-center">
                            <img src="~/images/noimage.jpg"
                                 class="img-thumbnail"
                                 style="height:150px; width:150px; object-fit:contain;"
                                 asp-append-version="true" />
                        </div>
                    }
                </div>
                <h4>Employee ID : @Model.Employee.Id</h4>
                <h4>Email : @Model.Employee.Email</h4>
                <h4>Department : @Model.Employee.Department</h4>
            </div>
            <div class="card-footer text-center">
                <a asp-controller="home" asp-action="index" class="btn btn-primary">Back</a>
                <a asp-action="edit" asp-controller="home" 
                   asp-route-id="@Model.Employee.Id" class="btn btn-primary">Edit</a>
                <a href="#" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
	<script src=" ~ /js/customscripts.js"></script>
}