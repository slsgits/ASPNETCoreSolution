@model EmployeeEditViewModel
@{
	ViewBag.Title = "Edit Employee";
}
<form enctype="multipart/form-data" asp-controller="Home" asp-action="edit" method="post" class="mt-3">
	<input type="hidden" asp-for="Id" />
	@for (int i = 0; i < Model.ExistingPhotoPaths.Count; i++)
	{
		<input type="hidden" asp-for="ExistingPhotoPaths[i]" />
	}

	<div asp-validation-summary="All"
		 class="text-danger">
	</div>
	<div class="row mb-3">
		<label asp-for="Name" class="col-sm-2 col-form-label"></label>
		<div class="col-sm-10">
			<input asp-for="Name" class="form-control" placeholder="Name" />
			<span asp-validation-for="Name" class="text-danger"></span>
		</div>
	</div>

	<div class="row mb-3">
		<label asp-for="Email" class="col-sm-2 col-form-label"></label>
		<div class="col-sm-10">
			<input asp-for="Email" class="form-control" placeholder="Email" />
			<span asp-validation-for="Email" class="text-danger"></span>
		</div>
	</div>

	<div class="row mb-3">
		<label asp-for="Department" class="col-sm-2 col-form-label"></label>
		<div class="col-sm-10">
			<select asp-for="Department" class="form-select"
					asp-items="Html.GetEnumSelectList<Dept>()">
				<option value="">Select Department</option>
			</select>
			<span asp-validation-for="Department" class="text-danger"></span>
		</div>
	</div>

	<div class="row mb-3">
		<label asp-for="Photos" class="col-sm-2 col-form-label"></label>
		<div class="col-sm-10">
			<input multiple asp-for="Photos" class="form-control" />
		</div>
	</div>
	<div class="row">
		@if (Model.ExistingPhotoPaths != null && Model.ExistingPhotoPaths.Any())
		{
			@foreach (var photoPath in Model.ExistingPhotoPaths)
			{
				<div class="col-md-3 mb-3 text-center">
					<img src="~/images/@photoPath"
						 class="img-thumbnail"
						 style="height:150px; width:150px; object-fit:contain;"
						 asp-append-version="true" 
						 title="@photoPath"/>
				</div>
			}
		}
		else
		{
			<div class="col-md-3 mb-3 text-center">
				<img src="~/images/noimage.jpg"
					 class="img-thumbnail"
					 style="height:150px; width:150px; object-fit:contain;"
					 asp-append-version="true" />
			</div>
		}
	</div>
	<div class="row mb-3">
		<div class="offset-sm-2 col-sm-10">
			<button type="submit" class="btn btn-primary">Update</button>
			<a asp-controller="home" asp-action="index" class="btn btn-primary">Cancel</a>
		</div>
	</div>
</form>