@model IEnumerable<Employee>
@{
	ViewBag.Title = "Employees List";
}
<h3>@ViewBag.Title</h3>
<table border="1">
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Department</th>
			</tr>
			@foreach (var employee in Model)
			{
				<tr>
					<td>@employee.Name</td>
					<td>@employee.Email</td>
					<td>@employee.Department</td>
				</tr>
			}
		</table>
