@model IEnumerable<Employee>
@{
	ViewBag.Title = "Employees List";
}

<div class="card-deck">
	@foreach (var employee in Model)
	{
		<div class="card m-3">
			<div class="card-header">
				<h3>@employee.Name</h3>
			</div>
			<img class="card-img-top" src="~/images/me.jpg" asp-append-version=true />
			<div class="card-footer text-center">
				<a asp-controller="home" asp-action="details" asp-route-id="@employee.Id" class="btn btn-primary" target="_blank">View</a>
				<a href="#" class="btn btn-primary">Edit</a>
				<a href="#" class="btn btn-danger">Delete</a>
			</div>
		</div>
	}
</div>
