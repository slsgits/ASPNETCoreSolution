@model IEnumerable<Employee>
@{
	ViewBag.Title = "Employees List";
}

<div class="border rounded p-4 shadow-sm row">
	@foreach (var employee in Model)
	{
		//var photoPath = "~/images/" + (employee.PhotoPath ?? "me.jpg");
		<div class="col-md-4 mb-4">
		<div class="card h-100">
			<div class="card-header">
				<h3>@employee.Name</h3>
			</div>
				@{
					var photoPath = employee.Photos.FirstOrDefault()?.FileName ?? "noimage.jpg";
				}

				<div class="text-center mt-2">
					<img src="~/images/@photoPath"
						 class="img-fluid rounded img-thumbnail"
						 style="height:150px; width:120px; object-fit:cover;"
						 asp-append-version=true
						 title="@photoPath" />
				</div>
			<div class="card-footer text-center">
				<a asp-controller="home" asp-action="details" asp-route-id="@employee.Id" class="btn btn-primary m-1" target="_blank">View</a>
				<a asp-action="edit" asp-controller="home" asp-route-id="@employee.Id" 
				   class="btn btn-primary m-1">Edit</a>
				<a asp-action="delete" asp-controller="home" asp-route-id="@employee.Id" 
				   class="btn btn-danger m-1">Delete</a>
			</div>
		</div>
		</div>
	}
</div>
